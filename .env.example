# LOS Hub Environment Variables Configuration Template
# Copy this file to .env.local for local dev and populate secrets in Azure Key Vault / App Service App Settings

# Core Public URL
NEXT_PUBLIC_SITE_URL="https://loshub.com"

# Azure Telemetry & Observability
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://westeurope-0.in.applicationinsights.azure.com/"

# Azure Blob Storage Configuration
AZURE_STORAGE_ACCOUNT="loshubstorage"
AZURE_STORAGE_CONTAINER="media"
AZURE_STORAGE_BASE_URL="https://loshubstorage.blob.core.windows.net"

# Azure Key Vault Configuration
AZURE_KEYVAULT_URL="https://loshub-kv.vault.azure.net/"

# Future Azure Cosmos DB / SQL Database Settings
AZURE_COSMOS_CONNECTION_STRING="AccountEndpoint=https://loshub-db.documents.azure.com:443/;AccountKey=mock-key;"

# Feature Flags
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"
NEXT_PUBLIC_DEFAULT_AIRPORT="MM2"
