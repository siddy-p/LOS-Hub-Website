# LOS Hub — Environment Variables
# Copy to .env.local for local development. NEVER commit real secrets to git.
# Production secrets must be set as Azure App Service App Settings.

# ============================================================
# PUBLIC — Safe to expose in browser bundles (NEXT_PUBLIC_)
# ============================================================
NEXT_PUBLIC_SITE_URL="https://los-hub.com"
NEXT_PUBLIC_ENABLE_DEMO_MODE="false"
NEXT_PUBLIC_DEFAULT_AIRPORT="MM2"

# ============================================================
# SERVER-ONLY — NEVER prefix with NEXT_PUBLIC_
# ============================================================

# Database (Azure Database for PostgreSQL Flexible Server)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://loshubadmin:CHANGE_ME@loshub-db.postgres.database.azure.com:5432/loshub?sslmode=require"

# Authentication (NextAuth.js v5)
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32"
NEXTAUTH_URL="https://los-hub.com"

# Azure Telemetry & Observability (Azure Application Insights)
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://westeurope-0.in.applicationinsights.azure.com/"

# Azure Communication Services — Email
# Get from: Azure Portal → Communication Services → loshub-email → Keys
ACS_CONNECTION_STRING="endpoint=https://loshub-email.communication.azure.com/;accesskey=CHANGE_ME"
ACS_SENDER_ADDRESS="noreply@los-hub.com"

# Azure Blob Storage (for future file uploads — itineraries, documents)
AZURE_STORAGE_ACCOUNT="loshubstorage"
AZURE_STORAGE_CONTAINER="media"
AZURE_STORAGE_BASE_URL="https://loshubstorage.blob.core.windows.net"

# Azure Key Vault (optional — for secret rotation)
AZURE_KEYVAULT_URL="https://loshub-kv.vault.azure.net/"

# Paystack Payment Gateway
# Get from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY="sk_live_CHANGE_ME"
PAYSTACK_PUBLIC_KEY="pk_live_CHANGE_ME"
PAYSTACK_WEBHOOK_SECRET="CHANGE_ME"
